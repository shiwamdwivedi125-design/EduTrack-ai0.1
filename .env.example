# EduTrack AI Environment Variables
APP_NAME=EduTrack AI
DEBUG=True

# Database (SQLite for local dev, PostgreSQL for production/Docker)
DATABASE_URL=sqlite:///./edutrack.db
# DATABASE_URL=postgresql://edutrack:edutrack_pass@db:5432/edutrack_db

# JWT Security (Change in production!)
SECRET_KEY=change-this-to-a-strong-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Origins (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Academic Thresholds
MIN_ATTENDANCE_PERCENT=75.0
LOW_ATTENDANCE_ALERT=65.0
MIN_PASS_MARKS_PERCENT=40.0
